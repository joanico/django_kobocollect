# Django Settings
SECRET_KEY=your-secret-key-here
DEBUG=True

# Database Configuration
DB_NAME=kobo_db
DB_HOST=127.0.0.1
DB_PORT=5433

# Enketo Express Configuration
# Set this to your Enketo service URL (default: http://localhost:8005)
ENKETO_URL=http://localhost:8005

# Enketo API Token (optional but recommended)
ENKETO_API_TOKEN=

# Site URL (optional - used for building return URLs)
SITE_URL=http://localhost:8000

# Enketo Request Timeout (optional, default: 30 seconds)
ENKETO_REQUEST_TIMEOUT=30

# Kobo Toolbox Configuration
KOBO_API_BASE_URL=https://kobo.humanitarianresponse.info/api/v2
ACCESS_TOKEN=your_kobo_access_token
KOBO_DEFAULT_ASSET_ID=aWN5dGyNjJSL8nZwxqh4E8
KOBO_REQUEST_TIMEOUT=30
